## Повод звонка для схемы: у «Объявлений» он случайный из списка.
static func premise_for(sch: Dictionary) -> String:
	if sch["id"] == "ads":
		return ADS_PREMISES.pick_random()
	return sch["premise"]


static func pick_scheme(owned: Array) -> Dictionary:
	var pool := []
	var total := 0
	for i in SCHEMES.size():
		if SCHEMES[i]["id"] in owned:
			total += i + 1
			pool.append([SCHEMES[i], total])
	var r := randi_range(1, maxi(total, 1))
	for p in pool:
		if r <= p[1]:
			return p[0]
	return SCHEMES[0]


static func passive_income(owned: Array) -> int:
	var sum := 0
	for s in SCHEMES:
		if s["id"] in owned:
			sum += int(s["passive"])
	return sum


## Способы забрать деньги. Карта и перевод по номеру есть сразу, остальные покупаются.
## cap — во сколько раз больше обычного бюджета клиент может отдать этим способом,
## chance — поправка к шансу согласия, heat — множитель жары за такую сделку.
## words — по каким словам в реплике игра понимает, что оператор предлагает этот способ.
