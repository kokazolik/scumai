## Генерирует вымышленный номер карты (проходит проверку Луна).
static func fake_card() -> String:
	var digits: Array[int] = [4]
	for i in range(14):
		digits.append(randi() % 10)
	var sum := 0
	for i in range(15):
		var d := digits[14 - i]
		if i % 2 == 0:
			d *= 2
			if d > 9:
				d -= 9
		sum += d
	digits.append((10 - sum % 10) % 10)
	var s := ""
	for i in range(16):
		s += str(digits[i])
		if i % 4 == 3 and i < 15:
			s += " "
	return s
