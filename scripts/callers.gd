class_name Callers
## Всех звонящих придумывает нейронка (Callers.generate).
## Профиль: name, age, source (откуда узнал номер), reason (зачем звонит), personality.

## Генерирует вымышленный номер карты (проходит проверку Луна).
static func fake_card() -> String:
	var digits: Array[int] = [4]
	for i in range(14):
		digits.append(randi() % 10)
	var sum := 0
	for i in range(15):
		var d := digits[14 - i]
		if i % 2 == 0:
			d *= 2
			if d > 9:
				d -= 9
		sum += d
	digits.append((10 - sum % 10) % 10)
	var s := ""
	for i in range(16):
		s += str(digits[i])
		if i % 4 == 3 and i < 15:
			s += " "
	return s


## Нейронка придумывает нового звонящего. Иногда это пародийная отсылка
## к известному персонажу (Балк вместо Халка, Граф Мрякула вместо Дракулы).
## Возвращает профиль или пустой словарь, если не вышло.
const THEMES := ["супергерои комиксов", "вампиры и монстры из ужастиков", "русские сказки и былины", "советские мультфильмы",
	"диснеевские мультфильмы", "фэнтези про волшебников и эльфов", "космическая фантастика", "греческие мифы",
	"классическая литература", "видеоигры", "боевики 90-х", "детективы", "пираты", "роботы и киборги", "аниме"]

const PEOPLE := ["студент", "дачник", "таксист", "бухгалтер", "пенсионер-шахматист", "мама в декрете", "фитнес-тренер",
	"сторож", "продавщица на рынке", "айтишник", "кладовщик", "библиотекарь", "кондуктор", "рыбак", "блогер-неудачник",
	"сантехник", "учительница", "охранник ТЦ", "кошатница", "бывший военный", "школьник-геймер", "вахтёрша", "фермер"]

## Первые буквы имён, чтобы нейронка не называла всех на «А».
const LETTERS := "БВГДЕЖЗИКЛМНОПРСТУФХЦШЭЮЯ"

## Сложность клиента по рангу игрока: от наивных к недоверчивым.
const DIFFICULTY := [
	"очень наивный и доверчивый, верит почти всему, легко соглашается",
	"доверчивый, немного сомневается, но быстро успокаивается от вежливости",
	"обычный человек: доверчивый, но задаёт пару проверочных вопросов",
	"осторожный: хочет подробностей и гарантий, но у него есть явная слабость, на которую он ведётся",
	"недоверчивый: проверяет слова, но очень хочет получить обещанное и поэтому может поддаться",
	"опытный и подозрительный, зато богатый и жадный до выгоды или статуса",
	"очень подозрительный богач, его надо обаять и дожать, у него одна сильная слабость",
	"самый сложный клиент: умный и богатый, но тщеславный, ведётся на эксклюзив",
]


## rank — индекс ранга игрока (сложность), money — сколько у клиента на карте, ₽.
static func generate(parody: bool, avoid: Array, premise := "", rank := 0, money := 0) -> Dictionary:
	var letter := LETTERS[randi() % LETTERS.length()]
	var kind := """Это ПАРОДИЙНЫЙ персонаж: смешная отсылка к известному герою фильмов, мультфильмов, книг или мифов.
Имя обязательно переделай в смешной каламбур, оригинальное имя не используй (примеры: «Балк» — огромный зелёный мужик, который злится и всё ломает; «Граф Мрякула» — кот-вампир из Трансильвании, боится чеснока и не выходит днём).
Повод звонка и характер обыгрывают его особенности, но звонит он как обычный клиент.
Возьми героя из этой области: %s.""" % THEMES.pick_random() if parody else \
"""Это обычный современный житель России. Узнаваемая история, немного смешная.
Пол: %s. Возраст: примерно %d. Подсказка к образу: %s.
Имя (или имя-отчество) начинается на букву «%s», выбери нечастое, но правдоподобное. Отчество тоже не шаблонное, не «Петровна».""" % [
	["мужчина", "женщина"].pick_random(), randi_range(17, 88), PEOPLE.pick_random(), letter]
	var sys := """Придумай одного человека, который звонит в подозрительную контору в сатирической игре про телефонных мошенников.
%s
%s
Сложность клиента: %s.%s
ВАЖНО: он хочет получить что-то, за что оператор может взять деньги ЗАРАНЕЕ, прямо по телефону: предоплату, бронь, взнос, сбор за доставку приза, оплату доступа, курса или консультации. Не придумывай желаний, которые нельзя продать до встречи, и людей, которые сами ничего не хотят.
Характер должен намекать, на что он поведётся и что его насторожит.
Не повторяй этих персонажей: %s.
Ответь строго JSON без пояснений:
{"name":"имя, коротко, до 25 символов, без скобок и пояснений","age":число,"source":"откуда узнал номер, одной фразой","reason":"зачем звонит, одной фразой","personality":"характер и слабые места, 1-2 фразы"}""" % [
		kind,
		("Он звонит, потому что клюнул на это: %s. Повод звонка связан с этим." % premise) if premise != "" else "Он узнал номер из рекламы, объявления, СМС, спама или сайта и звонит по конкретному поводу.",
		DIFFICULTY[clampi(rank, 0, DIFFICULTY.size() - 1)],
		(" Достаток: на карте у него около %d рублей, образ должен этому соответствовать." % money) if money > 0 else "",
		", ".join(avoid.slice(-12))]
	var res: Dictionary = await LLM.chat([
		{"role": "system", "content": sys},
		{"role": "user", "content": "Новый звонящий. Случайное число для разнообразия: %d" % randi()},
	], 1.0, 450, 1)
	if not res["ok"]:
		return {}
	var raw := str(res["text"])
	var a := raw.find("{")
	var b := raw.rfind("}")
	if a == -1 or b <= a:
		return {}
	var d = JSON.parse_string(raw.substr(a, b - a + 1))
	if not (d is Dictionary):
		return {}
	for k in ["name", "source", "reason", "personality"]:
		if str(d.get(k, "")).strip_edges() == "":
			return {}
	var nm := str(d["name"]).split("(")[0].split(",")[0].strip_edges()
	if nm.length() > 30:
		nm = nm.substr(0, 30).strip_edges()
	return {"name": nm, "age": clampi(int(d.get("age", 40)), 7, 999),
		"source": str(d["source"]), "reason": str(d["reason"]), "personality": str(d["personality"]),
		"generated": true}
